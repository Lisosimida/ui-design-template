# Copy to .env.local (already gitignored) and fill in.
#
# Local dev: run `npx supabase start` and copy the "API URL" and "anon key"
# values it prints.
#
# Production: these are NOT secrets (RLS is the security boundary, not the
# anon key's secrecy) — set them as plain Cloudflare env vars / Vercel-style
# NEXT_PUBLIC_ vars, not via `wrangler secret put`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — dashboard: Settings > Projects > (your project) > Client Keys (DSN).
# Not a secret (see instrumentation-client.ts for why); org/project are the
# slugs from your Sentry project URL, used only to label uploads, not auth.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — Project Settings > Project API Key. Also not a secret.
# api_host default (instrumentation-client.ts) is US cloud; set this only if
# your project is on EU cloud (https://eu.i.posthog.com) or self-hosted.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Resume analysis runs against a local Ollama server (lib/ollama/client.ts)
# — no API key, since it's not a hosted service. Both have defaults matching
# a fresh `ollama` install, so these are optional for local dev: only set
# them if your model or port differs, or `ollama pull` a model that isn't
# llama3.1 (make sure it supports Ollama's structured-output `format` field).
# NOTE: this repo deploys to Cloudflare Workers, which cannot reach
# "localhost" on your machine — a real deploy needs OLLAMA_BASE_URL pointing
# at an Ollama instance reachable from the internet (e.g. a tunnel or a
# server you run it on), or resume analysis will fail with a 502.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
