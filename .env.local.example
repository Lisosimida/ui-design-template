# Copy to .env.local (already gitignored) and fill in.
#
# Local dev: run `npx supabase start` and copy the "API URL" and "anon key"
# values it prints.
#
# Production: these are NOT secrets (RLS is the security boundary, not the
# anon key's secrecy) — set them as plain Cloudflare env vars / Vercel-style
# NEXT_PUBLIC_ vars, not via `wrangler secret put`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — dashboard: Settings > Projects > (your project) > Client Keys (DSN).
# Not a secret (see instrumentation-client.ts for why); org/project are the
# slugs from your Sentry project URL, used only to label uploads, not auth.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — Project Settings > Project API Key. Also not a secret.
# api_host default (instrumentation-client.ts) is US cloud; set this only if
# your project is on EU cloud (https://eu.i.posthog.com) or self-hosted.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Anthropic — console.anthropic.com > API Keys. This ONE IS a real secret
# (unlike everything above): it authenticates billed API calls, so on a
# Cloudflare Workers deploy set it with `npx wrangler secret put
# ANTHROPIC_API_KEY` instead of committing it here — see lib/anthropic/client.ts.
# This .env.local value is only a local-dev fallback (`next dev`/`next start`).
ANTHROPIC_API_KEY=
